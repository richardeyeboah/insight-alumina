# Generate distinct random values, never commit the real .env.
# Use hexadecimal password characters for safe DATABASE_URL composition.
DATABASE_PASSWORD=
CAL_WEBHOOK_SECRET=
# Comma-separated numeric Cal.com event type IDs; intake fails closed if empty.
CAL_EVENT_TYPE_IDS=
APP_ORIGIN=http://localhost:3000
AI_ANALYTICS_ENABLED=false
WORKER_CONCURRENCY=2
OLLAMA_URL=http://ollama:11434
# Select and pull a model appropriate for your server; no model is fabricated as installed.
OLLAMA_MODEL=

APP_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
# Production server domain, DNS pointing to the server.
SITE_DOMAIN=
