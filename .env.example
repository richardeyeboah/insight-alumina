# Reference only: Next.js reads apps/web/.env.local, Compose reads root .env.
# Public booking destination; never put API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_CAL_BOOKING_URL=
# Future phase 2 only; currently unused by the API scaffold.
DATABASE_URL=
CAL_WEBHOOK_SECRET=
CAL_API_KEY=
# Optional analytics is disabled until explicitly implemented and approved.
AI_ANALYTICS_ENABLED=false
